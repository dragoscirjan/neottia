{
  "name": "neottia-monorepo",
  "private": true,
  "type": "module",
  "description": "Unifying AI harnesses",
  "author": "Dragos Cirjan",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "overrides": {
      "vite": ">=6.4.3"
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "audit": "pnpm audit --audit-level=moderate",
    "build": "pnpm -r run --if-present build",
    "changeset": "changeset",
    "clean": "pnpm -r run --if-present clean && rimraf .nyc_output coverage docs/.vitepress/dist docs/.vitepress/cache",
    "docs": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "duplicate-check": "jscpd packages/ extensions/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "license-check": "pnpm licenses list --prod",
    "lint": "eslint --fix .",
    "lint:check": "eslint .",
    "release:global": "pnpm --filter @neottia/release release:prepare",
    "release:modules": "changeset publish",
    "serve": "vitepress dev docs",
    "start": "pnpm --filter @neottia/core start",
    "start:debug": "pnpm --filter @neottia/core start:debug",
    "test": "pnpm -r run --if-present test",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run --if-present typecheck",
    "validate": "pnpm run format:check && pnpm run lint:check && pnpm run duplicate-check && pnpm run test && pnpm run build",
    "version:modules": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@jscpd/badge-reporter": "^4.0.1",
    "@templ-project/eslint": "^1.3.0",
    "@templ-project/prettier": "^1.1.0",
    "@templ-project/vitest": "^0.3.2",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "import-sort-style-module": "^6.0.0",
    "jscpd": "^5.1.2",
    "lint-staged": "^17.4.1",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.6",
    "prettier-plugin-import-sort": "^0.0.7",
    "prettier-plugin-toml": "^2.0.6",
    "rimraf": "^6.1.2",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.0"
  }
}
