{
  "absolute": true,
  "blame": true,
  "cache": true,
  "gitignore": true,
  "ignore": [
    "**/*.config.js",
    "**/*.config.mjs",
    "**/*.min.js",
    "**/package.json",
    "**/tsconfig*.json",
    "**/*.harness.test.ts",
    "**/config.schema.json",
    "**/CHANGELOG.md",
    "**/*.spec-helper.ts",
    "**/*.test.ts",
    "coverage/**",
    "dist/**",
    "node_modules/**",
    "packages/sdlc/vendor/**"
  ],
  "output": ".jscpd",
  "reporters": ["badge", "console", "html"],
  "silent": false,
  "threshold": 2
}
