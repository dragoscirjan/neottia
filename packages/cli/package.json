{
  "name": "@neottia/cli",
  "version": "0.4.0",
  "description": "Command-line planner, installer, updater, uninstaller, and doctor for Neottia assets",
  "author": "Dragos Cirjan",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dragoscirjan/neottia.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/dragoscirjan/neottia/issues"
  },
  "homepage": "https://github.com/dragoscirjan/neottia#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "neottia": "./dist/cli.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "pretest": "node ../../scripts/run-unless-workspace-prebuilt.mjs pnpm --filter @neottia/cli... run build",
    "test": "vitest run --root ../.. packages/cli/src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neottia/config": "workspace:^",
    "@neottia/config-registry": "workspace:^",
    "@neottia/design-docs": "workspace:^",
    "@neottia/distribution": "workspace:^",
    "@neottia/harness-adapter": "workspace:^",
    "@neottia/issues": "workspace:^",
    "@neottia/memory-core": "workspace:^",
    "@neottia/opencode-adapter": "workspace:^",
    "@neottia/pi-adapter": "workspace:^",
    "@neottia/sdlc": "workspace:^",
    "@neottia/searchable-core": "workspace:^"
  },
  "devDependencies": {
    "@templ-project/tsconfig": "^0.2.2",
    "@types/node": "^25.0.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
