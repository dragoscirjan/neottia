{
  "extends": "@templ-project/tsconfig/esm",
  "compilerOptions": {
    "lib": ["ES2022"],
    "noEmit": true,
    "types": ["node"]
  },
  "exclude": [
    "**/*.fixture.ts",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/test-contract.ts",
    "coverage",
    "dist",
    "node_modules"
  ],
  "include": ["src/**/*.ts"]
}
