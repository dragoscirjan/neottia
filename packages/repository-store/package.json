{
  "name": "@neottia/repository-store",
  "version": "0.1.0",
  "description": "Crash-recoverable repository-local canonical file and disposable SQLite storage primitives",
  "author": "Dragos Cirjan",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dragoscirjan/neottia.git",
    "directory": "packages/repository-store"
  },
  "bugs": {
    "url": "https://github.com/dragoscirjan/neottia/issues"
  },
  "homepage": "https://github.com/dragoscirjan/neottia#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "pnpm run test:node && pnpm run test:bun && pnpm run test:cross-runtime",
    "test:node": "pnpm run build && vitest run --root ../.. packages/repository-store/src/repository-store.spec.ts packages/repository-store/src/sqlite/cache.spec.ts packages/repository-store/src/sqlite/node-adapter.spec.ts",
    "test:bun": "pnpm run build && bun test ./src/sqlite/bun-adapter.bun.test.ts",
    "test:cross-runtime": "pnpm run build && vitest run --root ../.. packages/repository-store/src/sqlite/cross-runtime.spec.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@templ-project/tsconfig": "^0.2.2",
    "@types/node": "^25.0.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
