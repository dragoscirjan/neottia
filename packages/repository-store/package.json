{
  "name": "@neottia/repository-store",
  "version": "0.3.4",
  "description": "Crash-recoverable repository-local canonical file and disposable SQLite storage primitives",
  "author": "Dragos Cirjan",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dragoscirjan/neottia.git",
    "directory": "packages/repository-store"
  },
  "bugs": {
    "url": "https://github.com/dragoscirjan/neottia/issues"
  },
  "homepage": "https://github.com/dragoscirjan/neottia#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "testing": ["dist/testing.d.ts"]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "native",
    "scripts/build-native.mjs",
    "scripts/install-native.mjs",
    "scripts/native-prebuild.mjs",
    "native-prebuilds.json",
    "binding.gyp",
    "README.md",
    "LICENSE"
  ],
  "gypfile": true,
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "pnpm run build:native && node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "build:native": "node scripts/build-native.mjs",
    "install": "node scripts/install-native.mjs",
    "test": "pnpm run test:installer && pnpm run test:node && pnpm run test:bun && pnpm run test:cross-runtime",
    "test:installer": "vitest run --root ../.. packages/repository-store/scripts/native-prebuild.spec.mjs",
    "test:node": "pnpm run build && vitest run --root ../.. packages/repository-store/src/diagnostics.spec.ts packages/repository-store/src/internal/native-integrity.spec.ts packages/repository-store/src/repository-store.spec.ts packages/repository-store/src/sqlite/cache.spec.ts packages/repository-store/src/sqlite/node-adapter.spec.ts",
    "test:bun": "pnpm run build && bun test ./src/sqlite/bun-adapter.bun.test.ts ./src/publication.bun.test.ts",
    "test:cross-runtime": "pnpm run build && vitest run --root ../.. packages/repository-store/src/sqlite/cross-runtime.spec.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "node-gyp": "^13.0.2"
  },
  "devDependencies": {
    "@templ-project/tsconfig": "^0.4.2",
    "@types/node": "^26.6.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "optionalDependencies": {
    "sigstore": "^4.1.1"
  }
}
