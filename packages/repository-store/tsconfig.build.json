{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "exclude": [
    "**/*.fixture.ts",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/test-contract.ts",
    "coverage",
    "dist",
    "node_modules"
  ],
  "include": ["src/**/*.ts"]
}
