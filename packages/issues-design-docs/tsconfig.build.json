{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "exclude": ["**/*.spec.ts", "**/*.test.ts", "coverage", "dist", "node_modules"],
  "include": ["src/**/*.ts"]
}
