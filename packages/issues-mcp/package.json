{
  "name": "@neottia/issues-mcp",
  "version": "0.1.0",
  "description": "Generic MCP stdio server for Neottia Issues",
  "author": "Dragos Cirjan",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dragoscirjan/neottia.git",
    "directory": "packages/issues-mcp"
  },
  "publishConfig": { "access": "public" },
  "bin": { "issues-mcp": "./dist/cli.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "vitest run --root ../.. packages/issues-mcp/src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": { "@modelcontextprotocol/sdk": "^1.30.0", "@neottia/issues": "workspace:*" },
  "devDependencies": {
    "@templ-project/tsconfig": "^0.2.2",
    "@types/node": "^25.0.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
