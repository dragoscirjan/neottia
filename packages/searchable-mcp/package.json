{
  "name": "@neottia/searchable-mcp",
  "version": "0.2.0",
  "description": "Generic MCP stdio server for Neottia Searchable",
  "author": "Dragos Cirjan",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dragoscirjan/neottia.git",
    "directory": "packages/searchable-mcp"
  },
  "publishConfig": { "access": "public" },
  "bin": { "searchable-mcp": "./dist/cli.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "pretest": "node ../../scripts/run-unless-workspace-prebuilt.mjs pnpm --filter @neottia/searchable-mcp... run build",
    "test": "vitest run --root ../.. packages/searchable-mcp/src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@neottia/config": "workspace:^",
    "@neottia/config-registry": "workspace:^",
    "@neottia/searchable-core": "workspace:*"
  },
  "devDependencies": {
    "@templ-project/tsconfig": "^0.4.2",
    "@neottia/testkit": "workspace:*",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
