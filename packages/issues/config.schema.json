{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "default": false,
      "type": "boolean"
    },
    "root": {
      "default": ".neottia/issues",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.?(?:\\/|$))(?!.*\\\\)[A-Za-z0-9._-]+(?:\\/[A-Za-z0-9._-]+)*$"
    },
    "prefix": {
      "default": "issue-",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "retrieval": {
      "type": "object",
      "properties": {
        "limit": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_bytes": {
          "default": 1048576,
          "type": "integer",
          "minimum": 1024,
          "maximum": 16777216
        }
      },
      "required": ["limit", "max_bytes"],
      "additionalProperties": false
    },
    "cache": {
      "type": "object",
      "properties": {
        "max_age_ms": {
          "default": 300000,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stale_policy": {
          "default": "prompt",
          "type": "string",
          "enum": ["prompt", "rebuild", "fail"]
        }
      },
      "required": ["max_age_ms", "stale_policy"],
      "additionalProperties": false
    },
    "lock": {
      "type": "object",
      "properties": {
        "wait_ms": {
          "default": 10000,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stale_ms": {
          "default": 60000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["wait_ms", "stale_ms"],
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "properties": {
        "max_file_bytes": {
          "default": 1048576,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_files": {
          "default": 10000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_total_bytes": {
          "default": 67108864,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_batch_paths": {
          "default": 1000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_query_bytes": {
          "default": 16384,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_query_rows": {
          "default": 10000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_result_bytes": {
          "default": 16777216,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "max_file_bytes",
        "max_files",
        "max_total_bytes",
        "max_batch_paths",
        "max_query_bytes",
        "max_query_rows",
        "max_result_bytes"
      ],
      "additionalProperties": false
    }
  },
  "required": ["enabled", "root", "prefix", "retrieval", "cache", "lock", "security"],
  "additionalProperties": false
}
