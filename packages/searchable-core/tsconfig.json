{
  "extends": "@templ-project/tsconfig/esm",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "types": ["node"]
  },
  "exclude": ["**/*.spec.ts", "**/*.test.ts", "coverage", "dist", "node_modules"],
  "include": ["src/**/*.ts"]
}
