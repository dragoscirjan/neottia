{
  "name": "@neottia/searchable-core",
  "version": "0.1.0",
  "description": "Concrete runtime and shared contracts for Searchable web tools",
  "author": "Dragos Cirjan",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dragoscirjan/neottia.git",
    "directory": "packages/searchable-core"
  },
  "bugs": {
    "url": "https://github.com/dragoscirjan/neottia/issues"
  },
  "homepage": "https://github.com/dragoscirjan/neottia#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config.schema.json": "./config.schema.json"
  },
  "files": ["dist", "README.md", "LICENSE", "NOTICE.md", "config.schema.json"],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/generate-config-schema.mjs && pnpm exec prettier --write config.schema.json",
    "pretest": "node ../../scripts/run-unless-workspace-prebuilt.mjs pnpm --filter @neottia/searchable-core... run build",
    "test": "vitest run --root ../.. packages/searchable-core/src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@neottia/config": "workspace:^",
    "@neottia/repository-store": "workspace:*",
    "jsdom": "^29.1.1",
    "turndown": "^7.2.4",
    "yaml": "^2.9.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@templ-project/tsconfig": "^0.2.2",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^26.5.1",
    "@types/turndown": "^5.0.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
