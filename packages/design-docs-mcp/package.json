{
  "name": "@neottia/design-docs-mcp",
  "version": "0.1.0",
  "description": "Generic MCP stdio server for Neottia Design Docs",
  "author": "Dragos Cirjan",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dragoscirjan/neottia.git",
    "directory": "packages/design-docs-mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "design-docs-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "vitest run --root ../.. packages/design-docs-mcp/src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@neottia/design-docs": "workspace:*",
    "@neottia/issues-design-docs": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@neottia/repository-store": "workspace:*",
    "@templ-project/tsconfig": "^0.2.2",
    "@types/node": "^25.0.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
