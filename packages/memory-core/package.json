{
  "name": "@neottia/memory-core",
  "version": "0.1.0",
  "description": "Standalone agent memory: filesystem-canonical records with SQLite FTS5 index, Postgres-ready backend interface",
  "author": "Dragos Cirjan",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dragoscirjan/neottia.git",
    "directory": "packages/memory-core"
  },
  "bugs": {
    "url": "https://github.com/dragoscirjan/neottia/issues"
  },
  "homepage": "https://github.com/dragoscirjan/neottia#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "vitest run --root ../.. packages/memory-core/src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@templ-project/tsconfig": "^0.2.2",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
