{
  "name": "@neottia/config",
  "version": "0.2.0",
  "description": "Typed contribution registry and immutable configuration snapshots for Neottia",
  "author": "Dragos Cirjan",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dragoscirjan/neottia.git",
    "directory": "packages/config"
  },
  "bugs": {
    "url": "https://github.com/dragoscirjan/neottia/issues"
  },
  "homepage": "https://github.com/dragoscirjan/neottia#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config.schema.json": "./config.schema.json"
  },
  "files": ["dist", "README.md", "LICENSE", "config.schema.json"],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "vitest run --root ../.. packages/config/src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@templ-project/tsconfig": "^0.2.2",
    "@types/node": "^25.0.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
