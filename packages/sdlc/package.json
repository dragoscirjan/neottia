{
  "name": "@neottia/sdlc",
  "version": "0.1.0",
  "description": "Canonical Neottia lifecycle configuration and asset compiler",
  "author": "Dragos Cirjan",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dragoscirjan/neottia.git",
    "directory": "packages/sdlc"
  },
  "bugs": {
    "url": "https://github.com/dragoscirjan/neottia/issues"
  },
  "homepage": "https://github.com/dragoscirjan/neottia#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "templates", "vendor", "README.md", "LICENSE"],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "vitest run --root ../.. packages/sdlc/src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neottia/config": "workspace:^",
    "@neottia/design-docs": "workspace:^",
    "@neottia/distribution": "workspace:^",
    "@neottia/harness-adapter": "workspace:^",
    "@neottia/issues": "workspace:^",
    "capitalize": "1.0.0",
    "esrever": "0.2.0",
    "iconv-lite": "0.6.3",
    "is-plain-object": "2.0.4",
    "isobject": "3.0.1",
    "levenshtein": "1.0.5",
    "locutus": "3.0.36",
    "luxon": "1.28.1",
    "pad": "2.3.0",
    "regex-parser": "2.3.1",
    "runes": "0.4.3",
    "snake-case": "2.1.0",
    "source-map": "0.6.1",
    "twig-lexer": "0.9.2",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@templ-project/tsconfig": "^0.4.2",
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
