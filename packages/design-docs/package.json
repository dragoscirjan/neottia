{
  "name": "@neottia/design-docs",
  "version": "0.1.0",
  "description": "Repository-local versioned design documents with strict Markdown/YAML and SQLite FTS5 search",
  "author": "Dragos Cirjan",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dragoscirjan/neottia.git",
    "directory": "packages/design-docs"
  },
  "bugs": {
    "url": "https://github.com/dragoscirjan/neottia/issues"
  },
  "homepage": "https://github.com/dragoscirjan/neottia#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config.schema.json": "./config.schema.json"
  },
  "files": ["dist", "README.md", "LICENSE", "config.schema.json"],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/generate-config-schema.mjs && pnpm exec prettier --write config.schema.json",
    "test": "vitest run --root ../.. packages/design-docs/src",
    "test:bun": "bun run scripts/bun-conformance.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neottia/repository-store": "workspace:^",
    "commonmark": "^0.31.2",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@templ-project/tsconfig": "^0.2.2",
    "@types/commonmark": "^0.27.10",
    "@types/node": "^25.0.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
