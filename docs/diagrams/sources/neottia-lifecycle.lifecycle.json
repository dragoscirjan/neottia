  "cards": [
    {
      "dot": "cyan",
      "title": "Commands stop at phase boundaries",
      "items": [
        "Plan records approved scope, Build records implementation evidence, Verify records a verdict, and Release prepares one action.",
        "No command silently invokes the next command."
      ]
    },
    {
      "dot": "rose",
      "title": "Approval does not carry forward",
      "items": [
        "Plan approval covers implementation scope, not remote release actions.",
        "Merge, publication, deployment, remote closure, and destructive actions remain human-authorized."
      ]
    },
    {
      "dot": "emerald",
      "title": "Continue and Refresh",
      "items": [
        "Every phase records append-only checkpoints with revisions, commits, checks, status, and the recommended next command.",
        "Continue resumes one checkpointed step. Refresh reports changed assumptions without moving the lifecycle."
      ]
    }
  ]
