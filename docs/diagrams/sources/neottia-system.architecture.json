  "cards": [
    {
      "dot": "cyan",
      "title": "One lifecycle, three hosts",
      "items": [
        "The compiler keeps Plan, Build, Verify, Release, Continue, and Refresh semantics host-neutral.",
        "Adapters change paths, metadata, package activation, and reload instructions for each harness."
      ]
    },
    {
      "dot": "emerald",
      "title": "Canonical versus disposable",
      "items": [
        "Canonical Memory, Issue, Design Doc, and Searchable records live under .neottia and belong in Git.",
        "SQLite files are derived indexes. Delete or rebuild them without deleting canonical records."
      ]
    },
    {
      "dot": "rose",
      "title": "Mutation boundaries",
      "items": [
        "Installation uses reviewable plans, ownership receipts, conflict checks, and recovery.",
        "Repository Store verifies platform capabilities before leased writes and fails closed on unsupported systems."
      ]
    }
  ]
