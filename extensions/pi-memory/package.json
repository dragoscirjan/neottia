{
  "name": "@neottia/pi-memory",
  "version": "0.1.1",
  "description": "pi extension: in-process memory tools from @neottia/memory-core",
  "author": "Dragos Cirjan",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dragoscirjan/neottia.git",
    "directory": "extensions/pi-memory"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["src", "README.md", "LICENSE"],
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "test": "vitest run --root ../.. extensions/pi-memory/src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neottia/config-registry": "workspace:^",
    "@neottia/memory-core": "workspace:*",
    "@neottia/pi-adapter": "workspace:*",
    "typebox": "^1.3.34"
  },
  "devDependencies": {
    "@neottia/testkit": "workspace:*",
    "@templ-project/tsconfig": "^0.4.2",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
